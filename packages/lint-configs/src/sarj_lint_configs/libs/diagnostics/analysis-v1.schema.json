{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.sarj.ai/schemas/analysis/v1",
  "title": "Sarj Standards analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "root",
    "completion",
    "conclusion",
    "exitCode",
    "diagnostics",
    "issues",
    "tools"
  ],
  "properties": {
    "$schema": { "const": "https://standards.sarj.ai/schemas/analysis/v1" },
    "schemaVersion": { "const": 1 },
    "root": { "type": "string" },
    "completion": { "enum": ["complete", "partial", "failed"] },
    "conclusion": { "enum": ["passed", "findings", "failed"] },
    "exitCode": { "enum": [0, 1, 2] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "character"],
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "range": { "$ref": "#/$defs/range" }
      },
      "not": { "required": ["position", "range"] }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "source", "location"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "source": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "help": { "type": "string" },
        "helpUrl": { "type": "string", "format": "uri" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kind", "message"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "exitCode": { "type": "integer" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "completion", "diagnosticCount", "issueCount"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "completion": { "enum": ["complete", "partial", "failed"] },
        "diagnosticCount": { "type": "integer", "minimum": 0 },
        "issueCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
