---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { ReferencePageProps as Props } from '../contracts';

const {
  title,
  description,
  sidebar,
  searchable: searchableProp,
  indexable: indexableProp,
  discovery,
  hasSidebar = true,
  template = 'doc',
} = Astro.props;
const searchable = searchableProp ?? (discovery === undefined || discovery === 'searchable');
const indexable = indexableProp ?? discovery !== 'unlisted';
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template,
    pagefind: searchable,
    prev: false,
    next: false,
    head: indexable ? [] : [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
  }}
  sidebar={sidebar}
  hasSidebar={hasSidebar}
>
  <div data-pagefind-body={searchable ? true : undefined} data-pagefind-ignore={searchable ? undefined : true}>
    <slot />
  </div>
</StarlightPage>

<script>
  const menu = document.querySelector('starlight-menu-button');
  const menuButton = menu?.querySelector('button');
  if (menu instanceof HTMLElement && menuButton instanceof HTMLButtonElement) {
    const syncExpanded = () => menuButton.setAttribute('aria-expanded', menu.getAttribute('aria-expanded') ?? 'false');
    syncExpanded();
    new MutationObserver(syncExpanded).observe(menu, { attributes: true, attributeFilter: ['aria-expanded'] });
  }
</script>
