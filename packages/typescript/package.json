{
  "name": "@sarj/eslint-plugin",
  "version": "16.38.51",
  "packageManager": "npm@12.2.1",
  "description": "Custom ESLint rules for hypermodern TypeScript / React / Next.js projects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarj-ai/code-standards.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://code-standards.sarj.ai/rules/eslint/",
  "bugs": {
    "url": "https://github.com/sarj-ai/code-standards/issues"
  },
  "scripts": {
    "build": "tsup",
    "dogfood": "npm run build && npm run dogfood:built",
    "lint": "node ../standards/src/sarj_standards/configs/eslint-selected-rules.mts \"{\\\"full\\\":true,\\\"config\\\":null,\\\"rules\\\":[],\\\"consoleOutput\\\":true,\\\"failOnWarnings\\\":true}\" -- . ../../.github/scripts ../standards/src ../standards/eslint.config.mts",
    "prepack": "npm run build && npm run verify-package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "verify-package": "node -e \"const fs=require('node:fs'),p=require('./package.json'),walk=x=>typeof x==='string'?[x]:x&&typeof x==='object'?Object.values(x).flatMap(walk):[];for(const file of new Set([p.main,p.module,p.types,...walk(p.exports)].filter(Boolean).map(x=>x.startsWith('./')?x.slice(2):x))){if(!file.startsWith('dist/'))throw new Error('export must live under dist: '+file);const stat=fs.statSync(file);if(!stat.isFile()||stat.size===0)throw new Error('missing or empty export: '+file)}\"",
    "dogfood:built": "eslint --config eslint.dogfood.config.ts src tests scripts eslint-rule-setting.ts eslint.config.ts eslint.dogfood.config.ts module-constant-naming-options.ts tsup.config.ts vitest.config.ts --max-warnings 0 && node -e \"import('./dist/index.js').then(({default:p}) => console.log('dogfood: '+Object.keys(p.rules).length+' TypeScript rules, 0 diagnostics'))\""
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "sarj",
    "react",
    "nextjs",
    "zod"
  ],
  "author": "sarj-ai",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "jsonc-parser": "^3.3.1",
    "ts-api-utils": "2.5.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@shadcn/lint": "0.2.3",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/rule-tester": "8.72.0",
    "@typescript-eslint/utils": "8.72.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-node-test": "1.0.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-zod": "^5.2.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "tsup": "9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.0",
    "uuid": "13.0.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "eslint": ">=9.39.4",
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.12",
    "esbuild": "0.28.2",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "nanoid@<3.3.20": "3.3.20"
  }
}
