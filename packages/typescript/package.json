{
  "name": "@sarj/oxlint-plugin",
  "version": "17.0.0",
  "packageManager": "npm@12.1.0",
  "description": "Sarj source policies for stock Oxlint",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sarj-astro-lint": "./dist/framework/astro-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./rule-examples": {
      "types": "./dist/rule-examples.d.ts",
      "default": "./dist/rule-examples.js"
    },
    "./select-rules": {
      "types": "./dist/select-rules.d.ts",
      "default": "./dist/select-rules.js"
    },
    "./upstream/unicorn": {
      "default": "./dist/upstream/unicorn.js"
    },
    "./upstream/perfectionist": {
      "default": "./dist/upstream/perfectionist.js"
    },
    "./upstream/simple-import-sort": {
      "default": "./dist/upstream/simple-import-sort.js"
    },
    "./upstream/zod": {
      "default": "./dist/upstream/zod.js"
    },
    "./upstream/node-test": {
      "default": "./dist/upstream/node-test.js"
    },
    "./upstream/react": {
      "default": "./dist/upstream/react.js"
    },
    "./upstream/core": {
      "default": "./dist/upstream/core.js"
    },
    "./upstream/jsdoc": {
      "default": "./dist/upstream/jsdoc.js"
    },
    "./upstream/typescript": {
      "default": "./dist/upstream/typescript.js"
    },
    "./upstream/playwright": {
      "default": "./dist/upstream/playwright.js"
    },
    "./upstream/testing-library": {
      "default": "./dist/upstream/testing-library.js"
    },
    "./upstream/bun": {
      "default": "./dist/upstream/bun.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./upstream/node": {
      "default": "./dist/upstream/node.js"
    },
    "./upstream/astro": {
      "types": "./types/astro.d.ts",
      "default": "./dist/upstream/astro.js"
    },
    "./upstream/query": {
      "default": "./dist/upstream/query.js"
    },
    "./upstream/shadcn": {
      "default": "./dist/upstream/shadcn/index.js"
    },
    "./upstream/better-tailwindcss": {
      "default": "./dist/upstream/better-tailwindcss/index.js"
    },
    "./upstream/nextjs": {
      "default": "./dist/upstream/nextjs.js"
    },
    "./upstream/test": {
      "default": "./dist/upstream/test.js"
    },
    "./upstream/sonarjs": {
      "default": "./dist/upstream/sonarjs.js"
    },
    "./framework/astro": {
      "types": "./types/framework-astro.d.ts",
      "default": "./dist/framework/astro.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "LICENSE.anti-slop",
    "vendor/PROVENANCE.json",
    "vendor/**/LICENSE*",
    "vendor/**/license",
    "vendor/**/PROVENANCE.json",
    "vendor/sonarjs/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarj-ai/code-standards.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://code-standards.sarj.ai/rules/oxlint/",
  "bugs": {
    "url": "https://github.com/sarj-ai/code-standards/issues"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-native-assets.mjs",
    "dogfood": "npm run build && npm run dogfood:built",
    "lint": "oxlint --config oxlint.config.mts --deny-warnings src tests tsup.config.ts vitest.config.ts scripts",
    "prepack": "npm run build && npm run verify-package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-package": "node scripts/verify-package.mjs",
    "dogfood:built": "oxlint --config oxlint.dogfood.config.mts --deny-warnings src tests tsup.config.ts vitest.config.ts scripts"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "sarj",
    "react",
    "nextjs",
    "zod"
  ],
  "author": "sarj-ai",
  "license": "MIT",
  "dependencies": {
    "@astrojs/compiler": "4.0.0",
    "@eslint/css-tree": "4.0.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@oxlint/plugins": "1.86.0",
    "@sarj/oxlint-react-hooks": "0.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "browserslist": "4.28.8",
    "change-case": "5.4.4",
    "cn": "0.3.2",
    "comment-parser": "1.4.9",
    "core-js-compat": "3.50.0",
    "detect-indent": "7.0.2",
    "enhanced-resolve": "5.26.0",
    "entities": "8.0.0",
    "es-iterator-helpers": "1.3.1",
    "eslint-visitor-keys": "5.0.1",
    "estraverse": "5.3.0",
    "find-up-simple": "1.0.1",
    "globals": "17.11.0",
    "identifier-regex": "1.1.0",
    "indent-string": "5.0.0",
    "is-builtin-module": "5.0.0",
    "jiti": "2.7.0",
    "jsdoc-type-pratt-parser": "9.2.2",
    "jsonc-parser": "3.3.1",
    "natural-compare": "1.4.0",
    "natural-orderby": "5.0.0",
    "oxc-parser": "0.152.0",
    "pluralize": "8.0.0",
    "quote-js-string": "0.1.0",
    "regjsparser": "0.13.2",
    "reserved-identifiers": "1.2.0",
    "resolve": "2.0.0-next.6",
    "semver": "7.8.5",
    "string.prototype.matchall": "4.0.12",
    "strip-indent": "4.1.1",
    "synckit": "0.11.13",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript-native": "npm:typescript@7.1.0-dev.20260919.1",
    "valibot": "1.5.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0",
    "tailwindcss": "^3.3.0 || ^4.1.17"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
