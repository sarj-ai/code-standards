{
  "name": "@sarj/eslint-plugin",
  "version": "19.18.0",
  "packageManager": "npm@12.2.1",
  "description": "Custom Oxlint rules for hypermodern TypeScript / React / Next.js projects",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./unicorn": {
      "import": "./dist/unicorn-js.js"
    },
    "./jsdoc": {
      "import": "./dist/jsdoc-js.js"
    },
    "./react": {
      "import": "./dist/react-js.js"
    },
    "./regexp": {
      "import": "./dist/regexp.js"
    },
    "./security": {
      "import": "./dist/security.js"
    },
    "./query": {
      "import": "./dist/query.js"
    },
    "./effects": {
      "import": "./dist/effects.js"
    },
    "./node-test": {
      "import": "./dist/node-test.js"
    },
    "./testing-library": {
      "import": "./dist/testing-library.js"
    },
    "./playwright": {
      "import": "./dist/playwright.js"
    },
    "./react-correctness": {
      "import": "./dist/react-correctness.js"
    },
    "./next": {
      "import": "./dist/next.js"
    },
    "./stylelint": {
      "import": "./dist/stylelint.js",
      "default": "./dist/stylelint.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarj-ai/code-standards.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://code-standards.sarj.ai/rules/oxlint/",
  "bugs": {
    "url": "https://github.com/sarj-ai/code-standards/issues"
  },
  "scripts": {
    "build": "tsup && node scripts/oxlint/build-upstream.ts",
    "lint": "(test -f dist/index.js || tsup) && export OXLINT_TSGOLINT_PATH=\"$PWD/node_modules/.bin/tsrs-lint\" && oxlint && cd ../standards && oxlint && cd ../../.github/scripts && oxlint",
    "prepack": "npm run build && npm run verify-package",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit && tsrs --project tsconfig.tools.json",
    "verify-package": "node -e \"const fs=require('node:fs'),p=require('./package.json'),walk=x=>typeof x==='string'?[x]:x&&typeof x==='object'?Object.values(x).flatMap(walk):[];for(const file of new Set([p.main,p.module,p.types,...walk(p.exports)].filter(Boolean).map(x=>x.startsWith('./')?x.slice(2):x))){if(!file.startsWith('dist/'))throw new Error('export must live under dist: '+file);const stat=fs.statSync(file);if(!stat.isFile()||stat.size===0)throw new Error('missing or empty export: '+file)}\""
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "sarj",
    "react",
    "nextjs",
    "zod"
  ],
  "author": "sarj-ai",
  "license": "MIT",
  "dependencies": {
    "@eslint/css-tree": "4.1.2",
    "change-case": "5.4.4",
    "oxc-parser": "0.148.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint-plugin-zod": "^5.2.2",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-eslint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "syncpack": "15.3.3",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsup": "9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "uuid": "13.0.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0",
    "tsrs": ">=0.23.0-ts7.1.0-beta",
    "typescript": ">=5.6.0 <7"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.12",
    "esbuild": "0.28.2",
    "nanoid@<3.3.20": "3.3.20"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
