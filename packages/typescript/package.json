{
  "name": "@sarj/eslint-plugin",
  "version": "19.0.0",
  "packageManager": "npm@12.2.1",
  "description": "Custom Oxlint rules for hypermodern TypeScript / React / Next.js projects",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarj-ai/code-standards.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://code-standards.sarj.ai/rules/oxlint/",
  "bugs": {
    "url": "https://github.com/sarj-ai/code-standards/issues"
  },
  "scripts": {
    "build": "tsup",
    "lint": "(test -f dist/index.js || tsup) && export OXLINT_TSGOLINT_PATH=\"$PWD/node_modules/.bin/tsrs-lint\" && oxlint && cd ../standards && oxlint && cd ../../.github/scripts && oxlint",
    "prepack": "npm run build && npm run verify-package",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit && tsrs --project tsconfig.tools.json",
    "verify-package": "node -e \"const fs=require('node:fs'),p=require('./package.json'),walk=x=>typeof x==='string'?[x]:x&&typeof x==='object'?Object.values(x).flatMap(walk):[];for(const file of new Set([p.main,p.module,p.types,...walk(p.exports)].filter(Boolean).map(x=>x.startsWith('./')?x.slice(2):x))){if(!file.startsWith('dist/'))throw new Error('export must live under dist: '+file);const stat=fs.statSync(file);if(!stat.isFile()||stat.size===0)throw new Error('missing or empty export: '+file)}\""
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "sarj",
    "react",
    "nextjs",
    "zod"
  ],
  "author": "sarj-ai",
  "license": "MIT",
  "dependencies": {
    "oxc-parser": "0.157.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@oxlint/plugins": "1.91.0",
    "@tanstack/eslint-plugin-query": "5.106.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-node-test": "1.0.1",
    "eslint-plugin-jsdoc": "65.4.4",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-zod": "^5.2.2",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-eslint": "1.91.0",
    "prettier": "3.9.10",
    "syncpack": "15.3.3",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsup": "9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "uuid": "14.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "tsrs": ">=0.23.0-ts7.1.0-beta"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.12",
    "esbuild": "0.28.2",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "nanoid@<3.3.20": "3.3.20"
  }
}
