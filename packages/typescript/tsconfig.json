{
  "extends": "../tsconfig/strict.json",
  "compilerOptions": {
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // Rule modules are `export default defineRule(...)`. isolatedDeclarations
    // (a d.ts-emit-parallelism constraint, not a type-safety one) would force an
    // explicit annotation on every default export for zero safety gain. Every
    // other strict flag stays on.
    "isolatedDeclarations": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
