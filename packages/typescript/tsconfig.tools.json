{
  "extends": "../tsconfig/strict.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "isolatedDeclarations": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "typescript": ["./node_modules/typescript/lib/typescript.d.ts"],
      "zod": ["./node_modules/zod/index.d.ts"],
      "syncpack": ["./node_modules/syncpack/syncpack.d.ts"],
      "oxlint": ["./node_modules/oxlint/dist/index.d.ts"],
      "oxfmt": ["./node_modules/oxfmt/dist/index.d.ts"],
      "@sarj/eslint-plugin": ["./src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "../standards/src/sarj_standards/libs/repository/rule_imports.mts",
    "../../.github/scripts/*.mts",
    "../standards/oxlint.config.mts",
    "../standards/src/sarj_standards/configs/*.mts",
    "../standards/src/sarj_standards/configs/action-parser/*.mts",
    "oxlint.config.mts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
