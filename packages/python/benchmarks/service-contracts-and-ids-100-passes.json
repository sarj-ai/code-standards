  "decisions": {
    "SARJ465": "Retain ERROR; prove native retained-callback dispatch and per-call HTTP service operations without relying on Queue/Client suffixes. Existing resolvable ABC/Protocol contracts remain valid.",
    "SARJ093": "ERROR for established singleton ID erasure and previously advisory imported/established-domain coverage; retain ownership, carrier, ambiguity, inheritance, operational and raw-boundary guards.",
    "SARJ068": "Promote supported short prose interpolation to ERROR under the stricter style policy. Stable literal prefixes count. String evidence alone does not prove custom operator/formatting equivalence; required custom semantics need an exact reasoned exception. Preserve the existing proven native-primitive str/repr/ascii safe-fix subset; other cases remain manual.",
    "SARJ532": "Stage WARNING without autofix for repeated Python field namespace prefixes on source-proven BaseSettings. Environment aliases do not establish groups; nesting needs explicit environment/source-precedence review."
  },
  "admission": {
    "service_gap": "Name exclusions and direct-call-only traversal missed native callback dispatch and per-call HTTP helpers.",
    "nominal_gap": "The two-role threshold missed a raw singleton field despite an established matching domain type.",
    "interpolation_gap": "Literal-only surrounding-text checks missed stable named prefixes; warnings did not block.",
    "settings_gap": "No existing source-semantic grouping rule covered repeated Python field prefixes.",
    "integration": "The inspected consumer used an older exact bundle pin; upgrading alone would not repair the demonstrated detector gaps. The inspected changed-file workflow did not establish a scope bypass."
  },
