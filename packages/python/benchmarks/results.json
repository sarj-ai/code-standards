  "reproduction": {
    "baseline_command": "git worktree add --detach /tmp/code-standards-benchmark-base 71e00f7b79aebe4a8a5d4d488c2f5e729332cdb1",
    "comparison_command": "uv run --project packages/python --frozen python packages/python/benchmarks/compare.py /tmp/code-standards-benchmark-base . --repeats 5 --output /tmp/standards-comparison.json",
    "native_benchmark_command": "uv run --project packages/python --frozen python -m sarj_python_lint.benchmark --repeats 5 packages/python/src",
    "example_runner_python": [
      "import hashlib,json,tempfile",
      "from pathlib import Path",
      "from sarj_python_lint.__main__ import analyze",
      "from sarj_python_lint.rules import REGISTRY",
      "rows=[];cases=0;positives=0;multifile=0;mismatches=[]",
      "with tempfile.TemporaryDirectory(prefix='standards-example-parity-') as temporary:",
      " for rule_id,rule in sorted(REGISTRY.items()):",
      "  for example in rule.public_examples():",
      "   root=Path(temporary)/rule_id/example.example_id",
      "   paths=[]",
      "   for item in example.files:",
      "    target=root/item.path;target.parent.mkdir(parents=True,exist_ok=True);target.write_text(item.source,encoding='utf-8')",
      "    if target.suffix=='.py':paths.append(target)",
      "   findings=analyze([rule_id],paths,root=root)",
      "   focus=[d for d in findings if d.path==root/example.focus_path and d.code==rule.code]",
      "   actual=[[str(d.path.relative_to(root)),d.line,d.col,d.code,d.message,d.severity.value,d.column_encoding.value] for d in findings]",
      "   rows.append([rule_id,example.example_id,actual])",
      "   if len(focus)!=example.expected_count:mismatches.append([rule_id,example.example_id,example.expected_count,len(focus)])",
      "   cases+=1;positives+=example.expected_count>0;multifile+=len(example.files)>1",
      "print(json.dumps({'rules':len(REGISTRY),'cases':cases,'positive_cases':positives,'negative_cases':cases-positives,'multifile_cases':multifile,'diagnostics':sum(len(row[2]) for row in rows),'digest':hashlib.sha256(json.dumps(rows,sort_keys=True).encode()).hexdigest(),'expected_mismatches':mismatches,'rows':rows}))"
    ],
    "example_commands": [
      "PYTHONPATH=/tmp/code-standards-benchmark-base/packages/python/src <python> /tmp/example-runner.py > /tmp/baseline-examples.json",
      "PYTHONPATH=packages/python/src:packages/contracts/src <python> /tmp/example-runner.py > /tmp/candidate-examples.json"
