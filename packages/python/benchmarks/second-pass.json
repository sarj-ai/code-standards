    "reproduction_python": [
      "import hashlib",
      "import json",
      "import os",
      "from pathlib import Path",
      "from statistics import median",
      "import subprocess",
      "import sys",
      "import tempfile",
      "",
      "WORKER = '''",
      "import cProfile, hashlib, json, sys, time",
      "from pathlib import Path",
      "from sarj_python_lint.__main__ import analyze, expand_paths",
      "root = Path(sys.argv[1])",
      "start = time.perf_counter()",
      "paths = expand_paths([root])",
      "elapsed = time.perf_counter() - start",
      "findings = analyze(['no-dunder-all'], paths)",
      "rows = [[str(d.path.relative_to(root)), d.line, d.col, d.code, d.message, d.severity.value, d.column_encoding.value] for d in findings]",
      "files = sorted(str(p.relative_to(root)) for p in paths)",
      "with cProfile.Profile() as profile:",
      "    repeated = expand_paths([root])",
      "assert paths == repeated",
      "scans = sum(e.callcount for e in profile.getstats() if isinstance(e.code, str) and 'scandir' in e.code)",
      "print(json.dumps({'seconds':elapsed, 'directory_scans':scans, 'files':files, 'diagnostics':rows}))",
      "'''",
      "",
      "baseline, candidate, output = (Path(value).resolve() for value in sys.argv[1:4])",
      "interpreter = Path(sys.executable).absolute()",
      "samples = {'baseline': [], 'candidate': []}",
      "expected = None",
      "with tempfile.TemporaryDirectory(prefix='standards-discovery-proof-') as directory:",
      "    root = Path(directory)",
      "    source = root / 'src'",
      "    source.mkdir()",
      "    for number in range(30):",
      "        text = '__all__ = [\"value\"]\\nvalue = 1\\n' if number == 0 else 'value = 1\\n'",
      "        (source / f'module_{number}.py').write_text(text, encoding='utf-8')",
      "    for ignored in ('.venv', 'node_modules', '.git'):",
      "        for number in range(500):",
      "            folder = root / ignored / f'package_{number}' / 'nested'",
      "            folder.mkdir(parents=True)",
      "            for file_number in range(4):",
      "                (folder / f'dependency_{file_number}.py').write_text('value = 1\\n', encoding='utf-8')",
      "    for round_number in range(5):",
      "        order = ('baseline', 'candidate') if round_number % 2 == 0 else ('candidate', 'baseline')",
      "        for kind in order:",
      "            checkout = baseline if kind == 'baseline' else candidate",
      "            search = os.pathsep.join(str(checkout / 'packages' / package / 'src') for package in ('python', 'contracts'))",
      "            result = subprocess.run([str(interpreter), '-c', WORKER, str(root)], cwd=checkout,",
      "                                    env=dict(os.environ, PYTHONPATH=search), text=True, capture_output=True, check=True)",
      "            sample = json.loads(result.stdout)",
      "            identity = {'files': sample.pop('files'), 'diagnostics': sample.pop('diagnostics')}",
      "            if expected is None:",
      "                expected = identity",
      "            assert identity == expected",
      "            assert len(identity['files']) == 30 and len(identity['diagnostics']) == 1",
      "            samples[kind].append({'round': round_number, **sample})",
      "assert expected is not None",
      "summary = {kind: median(sample['seconds'] for sample in rows) for kind, rows in samples.items()}",
      "report = {'retained_files': 30, 'ignored_python_files': 6000, 'samples': samples,",
      "          'median_seconds': summary, 'time_reduction_pct': 100 * (1 - summary['candidate'] / summary['baseline']),",
      "          'diagnostics': len(expected['diagnostics']),",
      "          'identity_digest': hashlib.sha256(json.dumps(expected, sort_keys=True).encode()).hexdigest(),",
      "          'harness_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),",
      "          'reproduction_python': Path(__file__).read_text().splitlines(),",
      "          'reproduction_command': '<python> discovery.py <baseline-checkout> <candidate-checkout> <output.json>'}",
      "output.write_text(json.dumps(report, indent=2) + '\\n', encoding='utf-8')",
      "print(json.dumps({key: report[key] for key in ('median_seconds', 'time_reduction_pct', 'identity_digest')}))"
    ],
