{
  "$comment": [
    "Every npm package the TypeScript capability (Oxlint, Stylelint, oxfmt, tsrs, React Doctor) loads or",
    "executes, at the exact versions this repo installs and tests: the binaries, the @sarj plugin",
    "the standalone upstream rule entrypoints, and the remaining plugins under `jsPlugins`.",
    "",
    "tsrs does all type checking and supplies `tsrs-lint` for type-aware rules, so there is no",
    "TypeScript compiler pair. `typescript` stays only because the React correctness rules import",
    "the TypeScript JavaScript API when it loads.",
    "",
    "`platformPackages` lists the platform binaries each peer ships as optionalDependencies at its own",
    "version. Installs exempt the peers and these exact versions from the repository's release-age and",
    "trust policies for that install only."
  ],
  "peers": {
    "@sarj/eslint-plugin": "19.18.0",
    "eslint-plugin-zod": "5.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-eslint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "parse5": "8.0.0",
    "stylelint": "18.0.0",
    "syncpack": "15.3.3",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "ageGatePreapprovals": {
    "@sarj/eslint-plugin": "19.18.0"
  },
  "platformPackages": {
    "oxfmt": [
      "@oxfmt/binding-android-arm-eabi",
      "@oxfmt/binding-android-arm64",
      "@oxfmt/binding-darwin-arm64",
      "@oxfmt/binding-darwin-x64",
      "@oxfmt/binding-freebsd-x64",
      "@oxfmt/binding-linux-arm-gnueabihf",
      "@oxfmt/binding-linux-arm-musleabihf",
      "@oxfmt/binding-linux-arm64-gnu",
      "@oxfmt/binding-linux-arm64-musl",
      "@oxfmt/binding-linux-ppc64-gnu",
      "@oxfmt/binding-linux-riscv64-gnu",
      "@oxfmt/binding-linux-riscv64-musl",
      "@oxfmt/binding-linux-s390x-gnu",
      "@oxfmt/binding-linux-x64-gnu",
      "@oxfmt/binding-linux-x64-musl",
      "@oxfmt/binding-openharmony-arm64",
      "@oxfmt/binding-win32-arm64-msvc",
      "@oxfmt/binding-win32-ia32-msvc",
      "@oxfmt/binding-win32-x64-msvc"
    ],
    "oxlint": [
      "@oxlint/binding-android-arm-eabi",
      "@oxlint/binding-android-arm64",
      "@oxlint/binding-darwin-arm64",
      "@oxlint/binding-darwin-x64",
      "@oxlint/binding-freebsd-x64",
      "@oxlint/binding-linux-arm-gnueabihf",
      "@oxlint/binding-linux-arm-musleabihf",
      "@oxlint/binding-linux-arm64-gnu",
      "@oxlint/binding-linux-arm64-musl",
      "@oxlint/binding-linux-ppc64-gnu",
      "@oxlint/binding-linux-riscv64-gnu",
      "@oxlint/binding-linux-riscv64-musl",
      "@oxlint/binding-linux-s390x-gnu",
      "@oxlint/binding-linux-x64-gnu",
      "@oxlint/binding-linux-x64-musl",
      "@oxlint/binding-openharmony-arm64",
      "@oxlint/binding-win32-arm64-msvc",
      "@oxlint/binding-win32-ia32-msvc",
      "@oxlint/binding-win32-x64-msvc"
    ],
    "syncpack": [
      "syncpack-darwin-arm64",
      "syncpack-darwin-x64",
      "syncpack-linux-arm64",
      "syncpack-linux-arm64-musl",
      "syncpack-linux-x64",
      "syncpack-linux-x64-musl",
      "syncpack-windows-arm64",
      "syncpack-windows-x64"
    ],
    "tsrs": [
      "@tsrs/darwin-arm64",
      "@tsrs/darwin-x64",
      "@tsrs/linux-arm64-gnu",
      "@tsrs/linux-arm64-musl",
      "@tsrs/linux-x64-gnu",
      "@tsrs/linux-x64-musl",
      "@tsrs/win32-x64"
    ]
  },
  "npmOverrides": {},
  "ceilings": {
    "typescript": "The React correctness rules use the TypeScript JavaScript API. TypeScript 7 has no JavaScript API, so the official TypeScript 6 compatibility package supplies it."
  }
}
