{
  "schema": 1,
  "rule": "iac:no-terraform-guard-blocks",
  "code": "SARJ222",
  "decision": "error-design-policy-after-published-warning-release",
  "admission": {
    "ownerOverride": "The repository owner explicitly requests a categorical style ban on validation, precondition, postcondition and check blocks, and excludes ordinary branching from the request.",
    "meaning": "Matches establish violations of that design policy, not intrinsic Terraform defects or proof that the guarded invariant is redundant.",
    "existingOwners": "Terraform owns native syntax, input types, provider validation and lifecycle behavior. Existing SARJ209, SARJ210 and SARJ217 cover narrower redundant validation, terraform_data guards and expression complexity. None implements the requested categorical policy.",
    "noChangeHarm": "Infrastructure declarations continue to mix deployment policy with resource configuration, retaining the verbosity and review burden the owner asked to remove.",
    "smallestFix": "Recognize Terraform-owned blocks through the shared HCL tree; emit one diagnostic per guard, or one per complete check block. Do not modify infrastructure or automatically delete source.",
    "remediation": "Move required invariants into their owning tests or deployment preflight before manual removal. Retain native protection and lifecycle settings."
  },
  "coverage": {
    "publicExamples": {
      "policyTruePositives": 4,
      "policyTrueNegatives": 4,
      "falsePositives": 0,
      "falseNegatives": 0
    },
    "nativeFocusedTests": 52,
    "fullIacSuitePassed": 2191,
    "boundaries": [
      "variable validation",
      "resource, data and ephemeral lifecycle precondition and postcondition",
      "output precondition",
      "top-level check with nested assertions and data sources",
      "LF and CRLF exact locations",
      "ordinary ternaries, count and for_each",
      "provider payloads and IAM condition",
      "prevent_destroy, deletion protection and ignore_changes",
      "comments, strings, heredocs and labelled lookalikes",
      "other dialects and Terraform JSON abstention",
      "shared malformed-input recovery",
      "no automatic guard removal",
      "native CLI warning/error status",
      "suppression and narrower diagnostic precedence scoped to the actual resource, including malformed and excepted neighbors"
    ]
  },
