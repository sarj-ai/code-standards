  "refinements": [
    "Retain both existing after-validator examples and add a second paired public scenario for data-union tags.",
    "Accept disjoint multi-value Literal domains, nested discriminators, required TypedDict tags, and ClassVar values.",
    "Distinguish repeated aliases from cycles, runtime strings from declared forward aliases, and ordinary containers from opaque tag domains.",
    "Exclude rebound or mutated owners, inherited/generic/behavior variants, generated and test paths, and unresolved variants.",
    "Keep opaque literal domains and partly unresolved candidate tags as review exclusions; bool/int equality collisions still overlap.",
    "Runtime and native compiler checks preserve constructor calls, demonstrate tag narrowing, and retain valid nominal narrowing."
  ],
  "exclusions": [
    "Inline annotations and unions containing unresolved imported variants are not analyzed.",
    "Imported tag domains are not fully resolved; this warning requests explicit source-visible tags rather than proving all Python unions invalid.",
