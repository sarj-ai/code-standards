      "owner": "BasedPyright",
      "url": "https://docs.basedpyright.com/latest/usage/type-concepts-advanced/",
      "result": "Supports both nominal isinstance and literal-field narrowing; compiler validity does not enforce this modeling preference."
    },
    {
      "owner": "Sarj",
      "rule": "eslint:prefer-discriminated-union",
      "result": "TypeScript already has its own union-modeling owner; this demonstrated gap is in Python SARJ510."
    }
