  "request": "Require explicit discriminators on declared data unions, including the supplied dataclass membership union.",
  "passDefinition": "One sequential, distinct labeled adversarial execution context per pass. These are 100 focused validation passes, not 100 independent repository audits or 100 new rules.",
  "admission": {
    "failureMode": "Record variants can have identical serialized field sets while lacking an explicit shared tag; consumers cannot use a stable common tag to select a variant.",
    "existingOwner": "SARJ510 already owns replacing validator-encoded state with discriminated Pydantic model unions.",
    "gap": "Its after-validator gate does not inspect already-declared unions of dataclasses or other data records.",
    "policyBoundary": "Nominal class unions are valid Python typing and support isinstance narrowing. This expansion implements the explicitly requested modeling preference as an advisory.",
    "smallestFix": "Expand the existing warning using bounded AST analysis; do not add another overlapping rule or an automatic wire/constructor change."
  },
  "upstreamReview": [
    {
