      "falsePositivePolicyCases": 0,
      "falseNegativePolicyCases": 0
    },
    "authoredPublicExamplePairs": 4,
    "authoredPublicExamples": 8,
    "integrationControls": [
      "error severity in both public presets",
      "exact-code local exception",
      "exception line scope",
      "malformed input stays a parser diagnostic"
    ],
    "boundaries": [
      "specific Zod object schemas",
      "owned discriminator unions",
      "TypeScript type-only queries",
      "literal undefined checks on identifiers with no local declaration",
      "shadowed globals, parameters, imports and temporal-dead-zone declarations",
      "authored JS, TS, JSX and tests",
      "generated/vendor shared exclusions",
      "no predicate, parser-name or schema-callback exemption"
    ]
  },
