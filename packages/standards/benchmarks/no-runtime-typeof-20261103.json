{
  "schema": 1,
  "rule": "eslint:no-runtime-typeof",
  "decision": "error-design-policy",
  "admission": {
    "warningStageOverride": "Direct error-level admission is intentional for this explicit source-design policy.",
    "meaning": "Matches establish policy violations, not intrinsic JavaScript correctness defects. Native primitive contracts require explained exceptions.",
    "noAutofix": "Changing boundary validation, owned union representation or transformation order can change accepted input and public behavior.",
    "policy": "Runtime typeof is an error in authored source; prefer specific Zod boundary schemas and discriminated unions for owned variants."
  },
  "coverage": {
    "ruleTesterCases": {
      "truePositivePolicyCases": 22,
