{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarj-docs-ui-site",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "docs-ui.sarj.ai",
      "custom_domain": true
    }
  ]
}
