{
  "name": "@sarj-ai/code-standards-docs",
  "version": "0.1.0",
  "packageManager": "npm@12.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "code-examples:check": "node scripts/format-code-examples.ts --check",
    "code-examples:sync": "node scripts/format-code-examples.ts --write",
    "prebuild": "npm run test:routing && npm run code-examples:check && npm run third-party-catalog:check",
    "postbuild": "node scripts/verify-third-party-catalog.ts --dist",
    "precheck": "npm run test:routing && npm run code-examples:check && npm run third-party-catalog:check",
    "predev": "npm run code-examples:check",
    "build": "astro build",
    "check": "astro check && tsrs --project tsconfig.tools.json",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint",
    "test:routing": "node --test scripts/site.test.ts scripts/format-python-examples.test.ts scripts/rule-introductions.test.ts scripts/rule-sort.test.ts scripts/json-boundaries.test.ts scripts/rule-search.test.ts",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "third-party-catalog:check": "node scripts/verify-third-party-catalog.ts --source",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "audit:dependencies": "node scripts/audit-dependencies.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@sarj/design": "0.5.0",
    "astro": "7.4.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@sarj/eslint-plugin": "file:../../packages/typescript",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-toml": "4.1.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "sql-formatter": "15.9.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "wrangler": "4.152.0",
    "@types/node": "26.6.5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "postcss-selector-parser": "7.1.7",
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "8.12.3"
    },
    "@sarj/design": {
      "@astrojs/starlight": "$@astrojs/starlight"
    },
    "minimatch@^10.0.0": "11.0.1"
  }
}
