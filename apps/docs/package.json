{
  "name": "@sarj-ai/code-standards-docs",
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "code-examples:check": "node scripts/format-code-examples.mjs --check",
    "code-examples:sync": "node scripts/format-code-examples.mjs --write",
    "prebuild": "npm run code-examples:check && npm run third-party-catalog:check",
    "postbuild": "node scripts/verify-third-party-catalog.mjs --dist",
    "precheck": "npm run code-examples:check && npm run third-party-catalog:check",
    "predev": "npm run code-examples:check",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "third-party-catalog:check": "node scripts/verify-third-party-catalog.mjs --source",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.10",
    "@sarj/design": "0.5.0",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@eslint/js": "10.0.1",
    "@sarj/eslint-plugin": "file:../../packages/typescript",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-sh": "0.19.0",
    "prettier-plugin-toml": "2.0.6",
    "react-doctor": "0.9.12",
    "sql-formatter": "15.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
