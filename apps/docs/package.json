{
  "name": "@sarj-ai/code-standards-docs",
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "code-examples:check": "node scripts/format-code-examples.ts --check",
    "code-examples:sync": "node scripts/format-code-examples.ts --write",
    "prebuild": "npm run code-examples:check && npm run third-party-catalog:check",
    "postbuild": "node scripts/verify-third-party-catalog.ts --dist",
    "precheck": "npm run code-examples:check && npm run third-party-catalog:check",
    "predev": "npm run code-examples:check",
    "build": "astro build",
    "check": "astro check && tsc --project tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "third-party-catalog:check": "node scripts/verify-third-party-catalog.ts --source",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "audit:dependencies": "node scripts/audit-dependencies.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@sarj/design": "0.5.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@sarj/eslint-plugin": "file:../../packages/typescript",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-toml": "4.0.0",
    "react-doctor": "0.9.18",
    "sql-formatter": "15.9.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.151.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "jiti": "2.7.0",
    "@types/node": "26.6.5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "8.11.2"
    },
    "@sarj/design": {
      "@astrojs/starlight": "$@astrojs/starlight"
    }
  }
}
