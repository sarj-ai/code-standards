---
import type { RuleExample } from '../lib/catalog';

interface Props {
  example: RuleExample;
}

const { example } = Astro.props;
---

<section class:list={['example', `example--${example.outcome}`]}>
  <header>
    <div>
      <p class="eyebrow">{example.outcome === 'reject' ? 'Before' : 'After'}</p>
      <h3>{example.title}</h3>
    </div>
  </header>
  {example.files.map((file) => (
    <figure>
      <figcaption>{file.path}</figcaption>
      <pre><code>{file.source}</code></pre>
    </figure>
  ))}
  {example.fixedFiles.length > 0 && (
    <details>
      <summary>Autofix output</summary>
      {example.fixedFiles.map((file) => (
        <figure>
          <figcaption>{file.path}</figcaption>
          <pre><code>{file.source}</code></pre>
        </figure>
      ))}
    </details>
  )}
</section>
