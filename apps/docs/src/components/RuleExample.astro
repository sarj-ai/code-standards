---
import { Code } from '@astrojs/starlight/components';

import type { Language, RuleExample } from '../lib/catalog';
import { languageForPath } from '../lib/code';

interface Props {
  example: RuleExample;
  languages: readonly Language[];
}

const { example, languages } = Astro.props;
const visibleFiles = example.files.filter((file) => file.source.trim().length > 0);
const visibleFixedFiles = example.fixedFiles.filter((file) => file.source.trim().length > 0);
---

<section class:list={['example', `example--${example.outcome}`]}>
  <header>
    <div>
      <p class="eyebrow">{example.outcome === 'reject' ? 'Before' : 'After'}</p>
      <h3>{example.title}</h3>
    </div>
  </header>
  <div class="example__code">
    {visibleFiles.map((file) => (
      <Code code={file.source} lang={languageForPath(file.path, languages)} title={file.path} frame="code" wrap />
    ))}
  </div>
  {visibleFixedFiles.length > 0 && (
    <details>
      <summary>Autofix output</summary>
      {visibleFixedFiles.map((file) => (
        <Code code={file.source} lang={languageForPath(file.path, languages)} title={file.path} frame="code" wrap />
      ))}
    </details>
  )}
</section>
