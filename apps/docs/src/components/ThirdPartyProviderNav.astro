---
import {
  thirdPartyProviderHref,
  thirdPartyProviderNavigationLabel,
  thirdPartyProvidersForNavigation,
  type ThirdPartyProvider,
} from '../lib/third-party-catalog';
import ThirdPartyProviderIcon from './ThirdPartyProviderIcon.astro';

interface Props {
  providers: ThirdPartyProvider[];
  activeProvider: string;
}

const { providers, activeProvider } = Astro.props;
const sortedProviders = thirdPartyProvidersForNavigation(providers);
---

<nav class="provider-nav" aria-label="Third party Rules">
  <ul>
    {sortedProviders.map((provider) => (
      <li>
        <a
          href={thirdPartyProviderHref(provider)}
          aria-current={provider.id === activeProvider ? 'page' : undefined}
          aria-label={provider.label}
        >
          <ThirdPartyProviderIcon providerId={provider.id} />
          <span>{thirdPartyProviderNavigationLabel(provider)}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  for (const navigation of document.querySelectorAll('.provider-nav')) {
    if (!(navigation instanceof HTMLElement) || navigation.dataset.ready === 'true') continue;
    navigation.dataset.ready = 'true';
    const active = navigation.querySelector('[aria-current="page"]');
    const scroller = navigation.querySelector('ul');
    if (active instanceof HTMLElement && scroller instanceof HTMLElement) {
      requestAnimationFrame(() => {
        scroller.scrollLeft = active.offsetLeft - (scroller.clientWidth - active.clientWidth) / 2;
      });
    }
  }
</script>
