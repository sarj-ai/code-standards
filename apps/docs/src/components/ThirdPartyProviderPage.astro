---
import { referenceSidebar } from '../lib/navigation';
import type { ThirdPartyProvider, ThirdPartyRule } from '../lib/third-party-catalog';
import ReferencePage from './ReferencePage.astro';
import ThirdPartyPagination from './ThirdPartyPagination.astro';
import ThirdPartyProviderHeader from './ThirdPartyProviderHeader.astro';
import ThirdPartyProviderNav from './ThirdPartyProviderNav.astro';
import ThirdPartyRuleList from './ThirdPartyRuleList.astro';

interface Props {
  provider: ThirdPartyProvider;
  providers: ThirdPartyProvider[];
  rules: ThirdPartyRule[];
  allProviderRules: ThirdPartyRule[];
  page: number;
  totalPages: number;
}

const { provider, providers, rules, allProviderRules, page, totalPages } = Astro.props;
const pageSuffix = page === 1 ? '' : ` · Page ${String(page)}`;
---

<ReferencePage
  title={`${provider.label} · Third party Rules${pageSuffix}`}
  description={`${provider.label} rules enabled by Sarj Standards.`}
  sidebar={[...referenceSidebar]}
>
  <article class="third-party-catalog">
    <ThirdPartyProviderNav {providers} activeProvider={provider.id} />
    <ThirdPartyProviderHeader {provider} rules={allProviderRules} />
    <ThirdPartyRuleList
      providerLabel={provider.label}
      providerId={provider.id}
      {rules}
      {allProviderRules}
      totalRuleCount={allProviderRules.length}
    />
    <ThirdPartyPagination {provider} {page} {totalPages} />
  </article>
</ReferencePage>
