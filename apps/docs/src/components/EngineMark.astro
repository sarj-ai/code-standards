---
import { engineLabel, type Engine } from '../lib/catalog';

interface Props {
  engine: Engine;
}

const { engine } = Astro.props;
const shortLabels: Partial<Record<Engine, string>> = { eslint: 'TS', iac: 'IaC', python: 'Py' };
const shortLabel = shortLabels[engine];
---

<span class:list={['engine-mark', `engine-mark--${engine}`]} role="img" aria-label={engineLabel(engine)} title={engineLabel(engine)}>
  {engine === 'sql' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <ellipse cx="12" cy="5.5" rx="7" ry="3" />
      <path d="M5 5.5v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6M5 11.5v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" />
    </svg>
  ) : engine === 'text' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 3.5h8l4 4v13H6z" />
      <path d="M14 3.5v4h4M9 12h6M9 15.5h6" />
    </svg>
  ) : shortLabel}
</span>
