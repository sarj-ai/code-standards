---
import {
  thirdPartyProviderPageHref,
  type ThirdPartyProvider,
} from '../lib/third-party-catalog';

interface Props {
  provider: ThirdPartyProvider;
  page: number;
  totalPages: number;
}

const { provider, page, totalPages } = Astro.props;
---

{totalPages > 1 && (
  <nav class="third-party-pagination" aria-label={`${provider.label} rule pages`}>
    {page > 1
      ? <a class="third-party-pagination__step" rel="prev" href={thirdPartyProviderPageHref(provider, page - 1)} aria-label="Previous page">←</a>
      : <span class="third-party-pagination__step" aria-disabled="true"><span aria-hidden="true">←</span><span class="sr-only">No previous page</span></span>}
    <span class="third-party-pagination__position"><span aria-hidden="true">{page} / {totalPages}</span><span class="sr-only">Page {page} of {totalPages}</span></span>
    {page < totalPages
      ? <a class="third-party-pagination__step" rel="next" href={thirdPartyProviderPageHref(provider, page + 1)} aria-label="Next page">→</a>
      : <span class="third-party-pagination__step" aria-disabled="true"><span aria-hidden="true">→</span><span class="sr-only">No next page</span></span>}
  </nav>
)}
