---
import type { ThirdPartyProvider, ThirdPartyRule } from '../lib/third-party-catalog';
import ThirdPartyProviderIcon from './ThirdPartyProviderIcon.astro';
import Breadcrumbs from '@sarj/design/Breadcrumbs.astro';
import { siteHref } from '../lib/site';

interface Props {
  provider: ThirdPartyProvider;
  rules: ThirdPartyRule[];
}

const { provider, rules } = Astro.props;
const projectionDescription = {
  complete: 'Complete effective rule inventory.',
  'config-explicit': 'Config-explicit rules only; implicit upstream defaults are not projected.',
  'provider-only': 'Pinned executable policy; individual provider rules are not expanded in this catalog.',
}[provider.projectionScope];
const displayedRuleCount = provider.id === 'mobsfscan' ? '51 runtime rules' : `${rules.length} rules`;
---

<header class="provider-header directory-heading">
  <div class="provider-header__identity">
    <ThirdPartyProviderIcon providerId={provider.id} />
    <div>
      <h1 class="engineering-visually-hidden">{provider.label}</h1>
      <Breadcrumbs ancestors={[{ label: 'Rules', href: siteHref('/rules/') }]} current={provider.label} />
      <p>{displayedRuleCount} <span aria-hidden="true">·</span> <code>{provider.package}@{provider.version}</code></p>
      <p>{projectionDescription}</p>
    </div>
  </div>
  <a class="provider-official-link" href={provider.homepage} aria-label={`Open the official ${provider.label} reference`}>
    Docs <span aria-hidden="true">↗</span>
  </a>
</header>
