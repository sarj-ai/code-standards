---
import { engineLabel, ruleHref, type Rule } from '../lib/catalog';

interface Props {
  rules: Rule[];
}

const { rules } = Astro.props;
const engines = [...new Set(rules.map((rule) => rule.engine))];
const categories = [...new Set(rules.map((rule) => rule.category))].sort();
const levels = [...new Set(rules.map((rule) => rule.defaultLevel))].sort();
const showEngine = engines.length > 1;
const showCategory = categories.length > 1;
const showLevel = levels.length > 1;
---

<section class="rule-directory">
  <p class="directory-status">
    <strong>{rules.length}</strong> {rules.length === 1 ? 'rule' : 'rules'}
  </p>

  <div class="rule-table-wrap">
    <table class="rule-table">
      <thead>
        <tr>
          <th scope="col">Rule</th>
          {showEngine && <th scope="col">Engine</th>}
          {showCategory && <th scope="col">Category</th>}
          {showLevel && <th scope="col">Default</th>}
        </tr>
      </thead>
      <tbody>
        {rules.map((rule) => (
          <tr
          >
            <th scope="row">
              <a href={ruleHref(rule)}><code>{rule.id}</code></a>
              <span>{rule.summary}</span>
            </th>
            {showEngine && <td data-label="Engine">{engineLabel(rule.engine)}</td>}
            {showCategory && <td data-label="Category"><span class="tag">{rule.category}</span></td>}
            {showLevel && <td data-label="Default"><span class:list={['level', `level--${rule.defaultLevel}`]}>{rule.defaultLevel}</span></td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
