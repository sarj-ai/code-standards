---
import SharedReferencePage from '@sarj/docs-ui/ReferencePage.astro';

import { referenceSidebar, type Sidebar } from '../lib/navigation';

interface Props {
  title: string;
  description: string;
  sidebar?: Sidebar;
  hasSidebar?: boolean;
  template?: 'doc' | 'splash';
  pagefind?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  sidebar = [...referenceSidebar],
  hasSidebar = true,
  template = 'doc',
  pagefind = true,
  noindex = false,
} = Astro.props;
---

<SharedReferencePage
  title={title}
  description={description}
  sidebar={sidebar}
  hasSidebar={hasSidebar}
  template={template}
  searchable={pagefind}
  indexable={!noindex}
>
  <slot />
</SharedReferencePage>
