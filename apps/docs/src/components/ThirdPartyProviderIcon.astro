  {providerId === 'zod' && <span class="provider-icon__letters">EZ</span>}
  {providerId === 'eslint-comments' && <span class="provider-icon__letters">EC</span>}
  {providerId === 'perfectionist' && <span class="provider-icon__letters">P</span>}
  {providerId === 'simple-import-sort' && <span class="provider-icon__letters">IS</span>}
  {providerId === 'unicorn' && <span class="provider-icon__letters">U</span>}
