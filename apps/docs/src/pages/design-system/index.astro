---
import Breadcrumbs from '@sarj/docs-ui/Breadcrumbs.astro';
import { componentCatalog, themeTokenCatalog } from '@sarj/docs-ui/catalog';

import ReferencePage from '../../components/ReferencePage.astro';

const components = Object.entries(componentCatalog);
---

<ReferencePage
  title="Documentation UI contract"
  description="Live components, public properties, and theme tokens exported by @sarj/docs-ui."
>
  <article class="ui-contract">
    <header class="ui-contract__hero">
      <p class="eyebrow">@sarj/docs-ui · live contract</p>
      <h1>Documentation UI</h1>
      <p class="lede">
        This page renders the same package exports used by the reference site. Component descriptions and token names
        come from the package catalog, so the public surface and its documentation change together.
      </p>
    </header>

    <section aria-labelledby="theme-title">
      <div class="section-heading">
        <h2 id="theme-title">Theme tokens</h2>
        <p>Switch the site theme to inspect both code-owned palettes.</p>
      </div>
      <ul class="token-grid">
        {themeTokenCatalog.map((token) => (
          <li style={`--token-swatch: var(${token.cssName})`}>
            <span class="token-grid__swatch" aria-hidden="true"></span>
            <code>{token.cssName}</code>
            <p>{token.purpose}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="components-title">
      <div class="section-heading">
        <h2 id="components-title">Component exports</h2>
        <p>The property table is generated from the typed package catalog.</p>
      </div>
      <div class="component-grid">
        {components.map(([name, definition]) => (
          <article class="component-card">
            <header>
              <h3>{name}</h3>
              <code>{definition.exportPath}</code>
              <p>{definition.purpose}</p>
            </header>
            {name === 'Breadcrumbs' && (
              <div class="component-card__preview">
                <Breadcrumbs
                  ancestors={[{ label: 'Reference', href: '/design-system/' }]}
                  current="Documentation UI"
                />
              </div>
            )}
            <dl>
              {Object.entries(definition.properties).map(([property, purpose]) => (
                <div>
                  <dt><code>{property}</code></dt>
                  <dd>{purpose}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>

    <footer class="machine-contract">
      <p>
        Machine-readable contract: <a href="/api/v1/docs-ui.json"><code>/api/v1/docs-ui.json</code></a>
      </p>
    </footer>
  </article>
</ReferencePage>

<style>
  .ui-contract {
    min-width: 0;
    max-width: 100%;
    padding-block: 1.25rem 3rem;
  }

  .ui-contract__hero {
    max-width: 52rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sarj-color-rule);
  }

  .ui-contract__hero h1 {
    margin-block: 0 1rem;
  }

  section {
    margin-top: 2.75rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) minmax(16rem, 1fr);
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .section-heading h2,
  .section-heading p {
    margin: 0;
  }

  .section-heading p,
  .component-card header p,
  .component-card dd,
  .machine-contract {
    color: var(--sl-color-gray-2);
  }

  .token-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--sarj-color-rule);
    list-style: none;
  }

  .token-grid li {
    min-width: 0;
    padding: 0.85rem;
    border-right: 1px solid var(--sarj-color-rule);
  }

  .token-grid__swatch {
    display: block;
    height: 4.5rem;
    margin-bottom: 0.85rem;
    border: 1px solid var(--sarj-color-rule);
    background: var(--token-swatch);
  }

  .token-grid code,
  .component-card > header > code {
    overflow-wrap: anywhere;
    font-size: 0.75rem;
  }

  .token-grid p {
    margin-block: 0.5rem 0;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }

  .component-grid {
    border-top: 1px solid var(--sarj-color-rule);
  }

  .component-card {
    display: grid;
    grid-template-columns: minmax(13rem, 0.5fr) minmax(16rem, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--sarj-color-rule);
  }

  .component-card h3 {
    margin-block: 0 0.35rem;
  }

  .component-card header p {
    margin-bottom: 0;
  }

  .component-card__preview {
    grid-column: 2;
    padding: 1rem;
    border: 1px solid var(--sarj-color-rule);
    background: var(--sarj-color-paper);
  }

  .component-card dl {
    grid-column: 2;
    margin: 0;
  }

  .component-card dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) 1fr;
    gap: 0.75rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--sarj-color-rule);
  }

  .component-card dt,
  .component-card dd {
    margin: 0;
  }

  .machine-contract {
    margin-top: 2rem;
  }

  @media (max-width: 48rem) {
    .section-heading,
    .component-card {
      grid-template-columns: 1fr;
    }

    .token-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .component-card__preview,
    .component-card dl {
      grid-column: 1;
    }
  }
</style>
