---
import CodeBlock from '../components/CodeBlock.astro';
import ReferencePage from '../components/ReferencePage.astro';
import { formattedStaticCode } from '../lib/display-code';
import { siteHref } from '../lib/site.ts';
---

<ReferencePage
  title="Code Standards"
  description="Lint rules and tested fixes for Python, TypeScript, SQL, infrastructure, and text."
>
  <article class="about-page sarj-about-page">
    <h1>Code Standards</h1>
    <p>Check Python, TypeScript, SQL, infrastructure, and text from one CLI. <a href={siteHref('/rules/')}>Browse rules and tested fixes</a>, then run the checks locally or in CI.</p>

    <section>
      <h2>Quick setup</h2>
      <CodeBlock code={formattedStaticCode.quickSetup} lang="bash" frame="terminal" wrap />
      <p><a href={siteHref('/cli/')}>CLI reference</a></p>
    </section>

    <section class="sarj-related-standards" aria-labelledby="related-standards">
      <h2 id="related-standards">Repository checks</h2>
      <p><a href="https://engineering.sarj.ai/projects/repo-standards/">Repo Standards</a> checks repository structure, pull requests, and Git history.</p>
    </section>
  </article>
</ReferencePage>
