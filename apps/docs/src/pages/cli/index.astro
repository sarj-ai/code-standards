---
import ReferencePage from '../../components/ReferencePage.astro';
import { Code } from '@astrojs/starlight/components';
import { cliReference, commandAnchor, flattenCommands, invocation, optionLabel } from '../../lib/cli';

const commands = flattenCommands().filter((command) => command.path[0] !== 'maintain');
const commandGroups = cliReference.commands.filter((command) => command.name !== 'maintain');
const quickStart = [
  cliReference.launcher.install,
  `${cliReference.program} setup`,
  `${cliReference.program} doctor`,
  `${cliReference.program} check`,
].join('\n');
const runOnce = `${cliReference.launcher.runLatest} setup`;
const workflow = [
  ['setup', 'Install the shared configuration and repository hooks.'],
  ['doctor', 'Check the installation and repair configuration drift.'],
  ['check', 'Run the same standards locally and in CI.'],
  ['fix', 'Apply safe automated fixes, then report what remains.'],
] as const;
---

<ReferencePage
  title="CLI reference"
  description={cliReference.summary}
>
  <section class="cli-setup" id="quick-start">
    <div>
      <h1>Setup</h1>
      <p>Install once, set up the repository, verify it, then run the full check.</p>
      <Code code={quickStart} lang="bash" frame="terminal" wrap />
      <details>
        <summary>Run once</summary>
        <Code code={runOnce} lang="bash" frame="terminal" wrap />
      </details>
    </div>
  </section>

  <ol class="cli-workflow" aria-label="Standard workflow">
    {workflow.map(([command, description]) => <li><code>{command}</code><span>{description}</span></li>)}
  </ol>

  <nav class="command-index" aria-label="CLI commands">
    {commandGroups.map((command) => <a href={`#${commandAnchor(command)}`}><code>{command.name}</code></a>)}
  </nav>

  {cliReference.globalOptions.length > 0 && (
    <section class="command-block" aria-labelledby="global-options">
      <div>
        <h2 id="global-options">Global options</h2>
        <dl class="option-list">
          {cliReference.globalOptions.map((option) => (
            <div>
              <dt><code>{optionLabel(option)}</code></dt>
              <dd>
                {option.summary}
                {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <div class="command-reference">
    {commands.map((command) => (
      <section id={commandAnchor(command)} class="command-block">
        <div>
          <h2><code>{invocation(command)}</code></h2>
          {command.summary && <p>{command.summary}</p>}
          <Code code={command.usage} lang="text" title="Usage" frame="code" wrap />
          {command.options.filter((option) => !option.names.includes('--help')).length > 0 && (
            <details class="command-options">
              <summary>Options ({command.options.filter((option) => !option.names.includes('--help')).length})</summary>
            <dl class="option-list">
              {command.options.filter((option) => !option.names.includes('--help')).map((option) => (
                <div>
                  <dt><code>{optionLabel(option)}</code></dt>
                  <dd>
                    {option.summary || 'See command help.'}
                    {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
                  </dd>
                </div>
              ))}
            </dl>
            </details>
          )}
        </div>
      </section>
    ))}
  </div>
</ReferencePage>
