---
import ReferencePage from '../../components/ReferencePage.astro';
import { cliReference, commandAnchor, invocation, optionLabel } from '../../lib/cli';

const commands = cliReference.commands;
const quickStart = [
  cliReference.launcher.install,
  `${cliReference.program} setup`,
  `${cliReference.program} doctor`,
  `${cliReference.program} check`,
].join('\n');
const runOnce = `${cliReference.launcher.runLatest} setup`;
---

<ReferencePage
  title="CLI reference"
  description={cliReference.summary}
>
  <header class="reference-hero">
    <p class="eyebrow">COMMAND LINE</p>
    <h1>Use Standards</h1>
    <p class="lede">{cliReference.summary}</p>
  </header>

  <section class="command-block" id="quick-start">
    <div class="command-block__gutter" aria-hidden="true">01</div>
    <div>
      <p class="eyebrow">QUICK START</p>
      <h2>Set up a repository</h2>
      <p>Install the tool, configure the repository, then verify it:</p>
      <pre><code>{quickStart}</code></pre>
      <button type="button" class="copy-button" data-copy={quickStart}>Copy command</button>
      <details>
        <summary>Run setup without installing the CLI</summary>
        <pre><code>{runOnce}</code></pre>
      </details>
    </div>
  </section>

  <div class="install-strip">
    <div>
      <span>Command</span>
      <code>{cliReference.program} --help</code>
    </div>
    <button type="button" class="copy-button" data-copy={`${cliReference.program} --help`}>Copy</button>
  </div>

  <nav class="command-index" aria-label="CLI commands">
    {cliReference.commands.map((command) => <a href={`#${commandAnchor(command)}`}><code>{command.name}</code></a>)}
  </nav>

  {cliReference.globalOptions.length > 0 && (
    <section class="command-block" aria-labelledby="global-options">
      <div class="command-block__gutter" aria-hidden="true">00</div>
      <div>
        <p class="eyebrow">EVERY COMMAND</p>
        <h2 id="global-options">Global options</h2>
        <dl class="option-list">
          {cliReference.globalOptions.map((option) => (
            <div>
              <dt><code>{optionLabel(option)}</code></dt>
              <dd>
                {option.summary}
                {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <div class="command-reference">
    {commands.map((command, index) => (
      <section id={commandAnchor(command)} class="command-block">
        <div class="command-block__gutter" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
        <div>
          <p class="eyebrow">{(command.path.join(' / ') || 'GLOBAL').toUpperCase()}</p>
          <h2><code>{invocation(command)}</code></h2>
          {command.summary && <p>{command.summary}</p>}
          <pre><code>{command.usage}</code></pre>
          {command.options.length > 0 && (
            <dl class="option-list">
              {command.options.map((option) => (
                <div>
                  <dt><code>{optionLabel(option)}</code></dt>
                  <dd>
                    {option.summary}
                    {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          <button type="button" class="copy-button" data-copy={invocation(command)}>Copy command</button>
        </div>
      </section>
    ))}
  </div>

  {cliReference.epilog && <p class="cli-epilog">{cliReference.epilog}</p>}

  <script>
    for (const button of document.querySelectorAll('[data-copy]')) {
      button.addEventListener('click', async () => {
        if (!(button instanceof HTMLButtonElement)) return;
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          return;
        }
        const original = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = original; }, 1400);
      });
    }
  </script>
</ReferencePage>
