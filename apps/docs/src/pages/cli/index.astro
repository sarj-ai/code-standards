---
import ReferencePage from '../../components/ReferencePage.astro';
import { cliReference, commandAnchor, flattenCommands, invocation, optionLabel } from '../../lib/cli';

const commands = flattenCommands().filter((command) => command.path[0] !== 'maintain' || command.path.length === 1);
const quickStart = [
  cliReference.launcher.install,
  `${cliReference.program} setup`,
  `${cliReference.program} doctor`,
  `${cliReference.program} check`,
].join('\n');
const runOnce = `${cliReference.launcher.runLatest} setup`;
---

<ReferencePage
  title="CLI reference"
  description={cliReference.summary}
>
  <header class="reference-hero reference-hero--compact">
    <h1>CLI</h1>
  </header>

  <section class="cli-setup" id="quick-start">
    <div>
      <h2>Setup</h2>
      <pre><code>{quickStart}</code></pre>
      <button type="button" class="copy-button" data-copy={quickStart} aria-live="polite">Copy</button>
      <details>
        <summary>Run once</summary>
        <pre><code>{runOnce}</code></pre>
      </details>
    </div>
  </section>

  <nav class="command-index" aria-label="CLI commands">
    {cliReference.commands.map((command) => <a href={`#${commandAnchor(command)}`}><code>{command.name}</code></a>)}
  </nav>

  {cliReference.globalOptions.length > 0 && (
    <section class="command-block" aria-labelledby="global-options">
      <div>
        <h2 id="global-options">Global options</h2>
        <dl class="option-list">
          {cliReference.globalOptions.map((option) => (
            <div>
              <dt><code>{optionLabel(option)}</code></dt>
              <dd>
                {option.summary}
                {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <div class="command-reference">
    {commands.map((command) => (
      <section id={commandAnchor(command)} class="command-block">
        <div>
          <h2><code>{invocation(command)}</code></h2>
          {command.summary && <p>{command.summary}</p>}
          <pre><code>{command.usage}</code></pre>
          {command.options.length > 0 && (
            <dl class="option-list">
              {command.options.map((option) => (
                <div>
                  <dt><code>{optionLabel(option)}</code></dt>
                  <dd>
                    {option.summary}
                    {option.choices.length > 0 && <small>Choices: {option.choices.join(', ')}</small>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          <button type="button" class="copy-button" data-copy={invocation(command)} aria-live="polite">Copy command</button>
        </div>
      </section>
    ))}
  </div>

  <script>
    const copyTimers = new WeakMap<HTMLButtonElement, number>();
    for (const button of document.querySelectorAll('[data-copy]')) {
      button.addEventListener('click', async () => {
        if (!(button instanceof HTMLButtonElement)) return;
        const original = button.textContent;
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          button.textContent = 'Copy failed';
          window.clearTimeout(copyTimers.get(button));
          copyTimers.set(button, window.setTimeout(() => { button.textContent = original; }, 1400));
          return;
        }
        window.clearTimeout(copyTimers.get(button));
        button.textContent = 'Copied';
        copyTimers.set(button, window.setTimeout(() => { button.textContent = original; }, 1400));
      });
    }
  </script>
</ReferencePage>
