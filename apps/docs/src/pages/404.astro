---
import ReferencePage from '../components/ReferencePage.astro';
---

<ReferencePage title="Rule not found" description="The requested Standards reference does not exist." hasSidebar={false} pagefind={false}>
  <div class="not-found">
    <p class="eyebrow">HTTP / 404</p>
    <h1>No diagnostic<br />for this path.</h1>
    <p>The rule may have been renamed, or the reference was entered incorrectly.</p>
    <div class="hero-actions">
      <a class="primary-action" href="/rules/">Search every rule</a>
      <a class="secondary-action" href="/">Return home</a>
    </div>
  </div>
</ReferencePage>
