---
import ReferencePage from '../components/ReferencePage.astro';
---

<ReferencePage
  title="Page not found"
  description="The requested Standards reference does not exist."
  hasSidebar={false}
  pagefind={false}
  noindex
>
  <div class="not-found">
    <h1>Page not found</h1>
    <p>The URL may be outdated or incorrect.</p>
    <div class="hero-actions">
      <a class="primary-action" href="/rules/">Rules</a>
      <a class="secondary-action" href="/">Home</a>
    </div>
  </div>
</ReferencePage>
