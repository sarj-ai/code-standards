---
import ReferencePage from '../../components/ReferencePage.astro';
import RuleTable from '../../components/RuleTable.astro';
import { catalog } from '../../lib/catalog';
---

<ReferencePage title="Rule directory" description={`Search and filter ${catalog.rules.length} deterministic code-quality rules.`}>
  <header class="reference-hero reference-hero--compact">
    <p class="eyebrow">RULE DIRECTORY / {catalog.rules.length}</p>
    <h1>Every policy,<br />with evidence.</h1>
    <p class="lede">Search by behavior, diagnostic code, language, or historical alias.</p>
  </header>
  <RuleTable rules={catalog.rules} />
</ReferencePage>
