---
import ReferencePage from '../../../components/ReferencePage.astro';
import RuleExample from '../../../components/RuleExample.astro';
import EngineMark from '../../../components/EngineMark.astro';
import { Code } from '@astrojs/starlight/components';
import { catalog, engineLabel, ruleHref, sourceUrl, type Rule } from '../../../lib/catalog';
import { referenceSidebar } from '../../../lib/navigation';

export function getStaticPaths() {
  return catalog.rules.map((rule, index) => ({
    params: { engine: rule.engine, id: rule.id },
    props: {
      rule,
      previousRule: catalog.rules[index - 1] ?? null,
      nextRule: catalog.rules[index + 1] ?? null,
    },
  }));
}

interface Props {
  rule: Rule;
  previousRule: Rule | null;
  nextRule: Rule | null;
}
const { rule, previousRule, nextRule } = Astro.props;
const exampleScenarios = [...new Set(rule.examples.map((example) => example.scenarioId))].map((scenarioId) => ({
  scenarioId,
  before: rule.examples.find((example) => example.scenarioId === scenarioId && example.outcome === 'reject')!,
  after: rule.examples.find((example) => example.scenarioId === scenarioId && example.outcome === 'accept')!,
}));
---

<ReferencePage title={`${rule.id} · ${engineLabel(rule.engine)}`} description={rule.summary} sidebar={[...referenceSidebar]}>
  <article class="rule-detail" data-pagefind-meta={`rule:${rule.key}`}>
    <header class="rule-detail__header">
      <nav class="rule-breadcrumb" aria-label="Breadcrumb">
        <a href={`/rules/${rule.engine}/`}><EngineMark engine={rule.engine} /></a>
        <span aria-hidden="true">·</span>
        <a href={`/rules/?category=${rule.category}`}>{rule.category}</a>
      </nav>
      <h1>{rule.id}</h1>
      <p class="lede">{rule.summary}</p>
      <div class="rule-header-links" data-pagefind-ignore>
        {rule.code && <code>{rule.code}</code>}
        {rule.messageIds.map((messageId) => <code>{messageId}</code>)}
        <a href={sourceUrl(rule.source)}>Rule source</a>
        <a href={sourceUrl(rule.test)}>Tests</a>
        <a href="/api/v1/catalog.json">Catalog JSON</a>
      </div>
    </header>

    <section class="rule-prose">
      <div>
        <h2>Why</h2>
        <p>{rule.rationale}</p>
      </div>
      <div>
        <h2>Fix</h2>
        <p>{rule.remediation}</p>
      </div>
    </section>

    {rule.examples.length > 0 && (
      <section class="examples-section">
        <h2>Examples</h2>
        <div class="examples-list">
          {exampleScenarios.map(({ scenarioId, before, after }) => (
            <div class="examples-grid" data-example-scenario={scenarioId}>
              <RuleExample example={before} languages={rule.languages} />
              <RuleExample example={after} languages={rule.languages} />
            </div>
          ))}
        </div>
      </section>
    )}

    {rule.filePatterns.length > 0 && <section class="rule-contract">
      {rule.filePatterns.length > 0 && <div>
        <h2>Files</h2>
        <div class="token-list">{rule.filePatterns.map((pattern) => <code>{pattern}</code>)}</div>
      </div>}
    </section>}

    {rule.optionsSchema && (
      <section class="options-schema">
        <h2>Options</h2>
        <Code code={JSON.stringify(rule.optionsSchema, null, 2)} lang="json" frame="code" wrap />
      </section>
    )}

    {rule.references.length > 0 && (
      <section class="references" data-pagefind-ignore>
        <h2>References</h2>
        <ul>{rule.references.map((reference) => <li><a href={reference}>{reference}</a></li>)}</ul>
      </section>
    )}

    {rule.aliases.length > 0 && <p class="aliases" data-pagefind-meta={`aliases:${rule.aliases.join(',')}`}>Formerly: {rule.aliases.join(', ')}</p>}

    <nav class="rule-pagination" aria-label="Rule navigation" data-pagefind-ignore>
      {previousRule ? (
        <a href={ruleHref(previousRule)} rel="prev" data-rule-previous aria-keyshortcuts="[">
          <span><kbd>[</kbd> Previous</span>
          <strong>{previousRule.id}</strong>
        </a>
      ) : <span></span>}
      {nextRule ? (
        <a href={ruleHref(nextRule)} rel="next" data-rule-next aria-keyshortcuts="]">
          <span>Next <kbd>]</kbd></span>
          <strong>{nextRule.id}</strong>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</ReferencePage>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|SELECT|TEXTAREA)$/.test(target.tagName))) return;
    const selector = event.key === '[' ? '[data-rule-previous]' : event.key === ']' ? '[data-rule-next]' : null;
    if (!selector) return;
    const link = document.querySelector(selector);
    if (link instanceof HTMLAnchorElement) location.assign(link.href);
  });
</script>
