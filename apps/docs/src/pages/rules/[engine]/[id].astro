---
import ReferencePage from '../../../components/ReferencePage.astro';
import RuleExample from '../../../components/RuleExample.astro';
import EngineMark from '../../../components/EngineMark.astro';
import InlineCodeText from '../../../components/InlineCodeText.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import RulePager from '@sarj/docs-ui/RulePager.astro';
import { catalog, engineLabel, ruleHref, sourceUrl, type Rule } from '../../../lib/catalog';
import { displayRule } from '../../../lib/display-code';
import { referenceSidebar } from '../../../lib/navigation';

export function getStaticPaths() {
  return catalog.rules.map((rule, index) => ({
    params: { engine: rule.engine, id: rule.id },
    props: {
      rule,
      previousRule: catalog.rules[index - 1] ?? null,
      nextRule: catalog.rules[index + 1] ?? null,
    },
  }));
}

interface Props {
  rule: Rule;
  previousRule: Rule | null;
  nextRule: Rule | null;
}
const { rule, previousRule, nextRule } = Astro.props;
const displayed = displayRule(rule);
const exampleScenarios = [...new Set(displayed.examples.map((example) => example.scenarioId))].map((scenarioId) => ({
  scenarioId,
  before: displayed.examples.find((example) => example.scenarioId === scenarioId && example.outcome === 'reject')!,
  after: displayed.examples.find((example) => example.scenarioId === scenarioId && example.outcome === 'accept')!,
}));
---

<ReferencePage title={`${rule.id} · ${engineLabel(rule.engine)}`} description={rule.summary} sidebar={[...referenceSidebar]}>
  <article class="rule-detail">
    <header class="rule-detail__header">
      <div class="rule-detail__toolbar">
        <nav class="rule-breadcrumb" aria-label="Breadcrumb">
          <a href={`/rules/${rule.engine}/`}><EngineMark engine={rule.engine} /></a>
          <span aria-hidden="true">·</span>
          <a href={`/rules/?category=${rule.category}`}>{rule.category}</a>
        </nav>
        <RulePager
          previous={previousRule ? { href: ruleHref(previousRule), label: previousRule.id } : null}
          next={nextRule ? { href: ruleHref(nextRule), label: nextRule.id } : null}
        />
      </div>
      <h1>{rule.id}</h1>
      <p class="lede"><InlineCodeText text={rule.summary} /></p>
      <div class="rule-header-links">
        {rule.code && <code>{rule.code}</code>}
        {rule.messageIds.map((messageId) => <code>{messageId}</code>)}
        <a href={sourceUrl(rule.source)}>Rule source</a>
        <a href={sourceUrl(rule.test)}>Tests</a>
        <a href="/api/v1/catalog.json">Catalog JSON</a>
      </div>
    </header>

    <section class="rule-prose">
      <div>
        <h2>Why</h2>
        <p><InlineCodeText text={rule.rationale} /></p>
      </div>
      <div>
        <h2>Fix</h2>
        <p><InlineCodeText text={rule.remediation} /></p>
      </div>
    </section>

    {rule.examples.length > 0 && (
      <section class="examples-section">
        <h2>Examples</h2>
        <div class="examples-list">
          {exampleScenarios.map(({ scenarioId, before, after }) => (
            <RuleExample id={`scenario-${scenarioId}`} {before} {after} languages={rule.languages} />
          ))}
        </div>
      </section>
    )}

    {rule.filePatterns.length > 0 && <section class="rule-contract">
      {rule.filePatterns.length > 0 && <div>
        <h2>Files</h2>
        <div class="token-list">{rule.filePatterns.map((pattern) => <code>{pattern}</code>)}</div>
      </div>}
    </section>}

    {rule.optionsSchema && (
      <section class="options-schema">
        <h2>Options</h2>
        <CodeBlock code={displayed.optionsSchemaSource!} lang="json" frame="code" wrap />
      </section>
    )}

    {rule.references.length > 0 && (
      <section class="references">
        <h2>References</h2>
        <ul>{rule.references.map((reference) => <li><a href={reference}>{reference}</a></li>)}</ul>
      </section>
    )}

    {rule.aliases.length > 0 && <p class="aliases">Formerly: {rule.aliases.join(', ')}</p>}

  </article>
</ReferencePage>
